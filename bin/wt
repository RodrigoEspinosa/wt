#!/usr/bin/env bash
set -euo pipefail

VERSION="0.7.0"
PROG="wt"

# --- helpers ----------------------------------------------------------------

die() { printf '%s: %s\n' "$PROG" "$1" >&2; exit 1; }

# Run "$@" while showing a spinner on stderr, so slow git operations don't look
# like a freeze. Falls back to a plain run when stderr isn't a terminal (scripts,
# CI, tests). Returns the command's exit status; its output is captured and
# replayed afterwards so it never collides with the spinner line.
spin() {
  local msg="$1"; shift
  if [ ! -t 2 ]; then
    # No terminal (scripts, CI, tests): leave a breadcrumb and run plainly. The
    # command's own output goes to stderr so stdout stays reserved for results.
    printf '%s: %s...\n' "$PROG" "$msg" >&2
    "$@" >&2
    return $?
  fi

  local out
  out="$(mktemp)"
  "$@" >"$out" 2>&1 &
  local pid=$! i=0 rc=0
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  trap 'kill "$pid" 2>/dev/null; printf "\r\033[K\033[?25h" >&2' INT TERM
  printf '\033[?25l' >&2
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r%s %s' "${frames[i++ % ${#frames[@]}]}" "$msg" >&2
    sleep 0.08
  done
  wait "$pid" || rc=$?
  printf '\r\033[K\033[?25h' >&2
  trap - INT TERM
  [ -s "$out" ] && cat "$out" >&2
  rm -f "$out"
  return $rc
}

usage() {
  cat <<EOF
Usage: $PROG [<branch> [<start-point>]]
       $PROG pr <number>
       $PROG clean [--list] [--prune] [--yes]
       $PROG -d <branch>
       $PROG -l
       $PROG init <shell>

Git worktree manager powered by fzf.

With no arguments, launches fzf to fuzzy-pick a worktree. In the picker,
enter switches, ctrl-n creates a worktree from the typed name,
ctrl-d/del deletes the highlighted one, and tab cycles the preview between
an overview and the branch's diff against the default branch.
With <branch>, switches to that worktree — creating it if it doesn't exist.
A new branch starts at <start-point> if given (commit, branch, or tag).

Commands:
  pr <number>   Check out a GitHub pull request in a new worktree
  clean         Review every worktree with its disk usage, last activity, and
                whether it is safe to remove, then pick which to remove
                (fzf multi-select). --list prints the report only; --prune
                fetches/prunes remotes first; --yes removes every safe one
  init <shell>  Print shell integration (bash, zsh, fish)

Options:
  -d <branch>   Remove the worktree for <branch> (deletes the local branch
                too if it is fully merged)
  -l            List worktrees (no fzf)
  -h            Show this help
  -v            Show version

Setup:
  Add to your shell rc file:
    eval "\$($PROG init zsh)"    # or bash, fish

Hooks:
  Drop a .wtconfig file at the repo root to prep new worktrees automatically:
    copy = .env                # copy file/dir from the primary worktree
    link = node_modules        # symlink from the primary worktree
    postCreate = pnpm install  # shell command run inside the new worktree
  copy/link/postCreate may each appear multiple times. Set WT_NO_HOOKS=1 to skip.

  A baseDir = <path> line in .wtconfig sets the worktree parent directory per
  repo (overridden by WT_BASE_DIR). Relative paths resolve against the repo root.

Environment:
  WT_BASE_DIR   Parent directory for worktrees (default: <repo>/_worktrees)
  WT_NO_HOOKS   When set, skip .wtconfig copy/link/postCreate hooks
  WT_HERDR      Set to "workspace" to open worktrees as herdr workspaces
                (only inside herdr) instead of cd'ing the current shell
EOF
  exit 0
}

# --- ensure we're in a git repo ---------------------------------------------

ensure_git() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
}

# --- resolve paths ----------------------------------------------------------

repo_root() {
  local toplevel
  toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || true
  if [ -n "$toplevel" ]; then
    echo "$toplevel"
  else
    git rev-parse --git-dir
  fi
}

worktree_base() {
  # WT_BASE_DIR wins, then a baseDir key in .wtconfig, then the default.
  if [ -n "${WT_BASE_DIR:-}" ]; then
    echo "$WT_BASE_DIR"
    return
  fi

  local configured
  configured="$(config_get baseDir | head -n1)"
  if [ -n "$configured" ]; then
    case "$configured" in
      /*)  echo "$configured" ;;                          # absolute
      \~*) echo "$HOME${configured#\~}" ;;                # home-relative
      *)   echo "$(repo_root)/$configured" ;;             # relative to repo root
    esac
    return
  fi

  echo "$(repo_root)/_worktrees"
}

# Convert a branch name to a flat directory name (e.g. rec/foo -> rec-foo).
safe_dirname() {
  printf '%s' "$1" | tr '/' '-'
}

# The primary (main) working tree — the first entry git reports. This is the
# source of truth for .wtconfig and the files copied/linked into new worktrees.
primary_worktree() {
  git worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }'
}

# --- config & hooks ---------------------------------------------------------

# Path to the .wtconfig file in the primary worktree, if one exists.
config_path() {
  local root
  root="$(primary_worktree)"
  [ -n "$root" ] && [ -f "$root/.wtconfig" ] && echo "$root/.wtconfig"
}

# Print every value for <key> in .wtconfig, one per line. Lines look like
# "key = value"; blank lines and those starting with # are ignored.
config_get() {
  local key="$1" file
  file="$(config_path)"
  [ -z "$file" ] && return 0
  sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*//p" "$file" | sed 's/[[:space:]]*$//'
}

# Run the .wtconfig hooks for a freshly created worktree. All output goes to
# stderr so stdout stays reserved for the worktree path the shell wrapper cd's
# into. Failures are reported but never abort the switch.
run_hooks() {
  local branch="$1" wt_path="$2"
  [ -n "${WT_NO_HOOKS:-}" ] && return 0

  local src
  src="$(primary_worktree)"
  [ -z "$src" ] && return 0

  local f
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ -e "$src/$f" ]; then
      mkdir -p "$(dirname "$wt_path/$f")"
      cp -R "$src/$f" "$wt_path/$f" && printf '%s: copied %s\n' "$PROG" "$f" >&2
    else
      printf '%s: skip copy %s (not in primary worktree)\n' "$PROG" "$f" >&2
    fi
  done < <(config_get copy)

  while IFS= read -r f; do
    [ -z "$f" ] && continue
    if [ -e "$src/$f" ]; then
      mkdir -p "$(dirname "$wt_path/$f")"
      ln -s "$src/$f" "$wt_path/$f" && printf '%s: linked %s\n' "$PROG" "$f" >&2
    else
      printf '%s: skip link %s (not in primary worktree)\n' "$PROG" "$f" >&2
    fi
  done < <(config_get link)

  local cmd
  while IFS= read -r cmd; do
    [ -z "$cmd" ] && continue
    printf '%s: postCreate: %s\n' "$PROG" "$cmd" >&2
    if ! ( cd "$wt_path" && WT_BRANCH="$branch" WT_PATH="$wt_path" WT_SOURCE="$src" \
             bash -c "$cmd" ) >&2; then
      printf '%s: postCreate hook failed (continuing)\n' "$PROG" >&2
    fi
  done < <(config_get postCreate)
}

# --- core functions ---------------------------------------------------------

list_worktrees() {
  local target="${1:-}"
  git worktree list --porcelain | TARGET="$target" awk '
    BEGIN { target = ENVIRON["TARGET"] }
    /^worktree / { path = substr($0, 10) }
    /^branch /   {
      branch = substr($0, 8);
      sub("refs/heads/", "", branch);
      if (target != "") {
        if (branch == target) { print path; exit }
      } else {
        print branch "\t" path
      }
    }
    /^detached/  {
      if (target != "") {
        if (target == "(detached)" && path != "") { print path; exit }
      } else if (path != "") {
        print "(detached)\t" path
      }
    }
  '
}

# Decorate worktrees for display. Emits, per worktree, five tab-separated
# fields: "<flags>\t<branch>\t<path>\t<ahead/behind>\t<agent>".
#   flags  two markers — '*' for the worktree you're currently in, '!' if it
#          has uncommitted changes (tracked or untracked).
#   a/b    "↑N" commits ahead / "↓N" behind its upstream, when it has one.
#   agent  the herdr agent's state in that worktree (see agent_label), if any.
# The branch and path stay in their own clean fields so callers can parse them.
# Decorate a single worktree (<branch> <path>) and print its four-field row.
# Each call shells out to git status + rev-list, so annotate_worktrees runs many
# of these in parallel. --no-optional-locks keeps git status from rewriting the
# index, which would collide with agents running git in that worktree. WT_CUR_TOP names the worktree we're currently in, and
# WT_AGENTS holds herdr_agent_statuses output, looked up here without herdr.
annotate_one() {
  local branch="$1" path="$2"
  local cur=" " dirty=" " ab="" agent="" counts behind ahead
  [ "$path" = "${WT_CUR_TOP:-}" ] && cur="*"
  [ -n "$(git --no-optional-locks -C "$path" status --porcelain 2>/dev/null || true)" ] && dirty="!"

  counts="$(git -C "$path" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || true)"
  if [ -n "$counts" ]; then
    behind="${counts%%	*}"
    ahead="${counts##*	}"
    [ "${ahead:-0}" != 0 ] && ab="$ab ↑$ahead"
    [ "${behind:-0}" != 0 ] && ab="$ab ↓$behind"
  fi

  if [ -n "${WT_AGENTS:-}" ]; then
    agent="$(printf '%s\n' "$WT_AGENTS" |
      P="$path" awk -F'\t' '$1 == ENVIRON["P"] { print $2; exit }')"
    agent="$(agent_label "$agent")"
  fi

  printf '%s%s\t%s\t%s\t%s\t%s\n' "$cur" "$dirty" "$branch" "$path" "$ab" "$agent"
}

# Short display form of a herdr agent_status. Idle and unknown states print
# nothing so only agents worth a glance stand out.
agent_label() {
  case "$1" in
    working) echo "● working" ;;
    blocked) echo "◆ blocked" ;;
    done)    echo "✓ done" ;;
  esac
}

# Decorate every worktree for display, computing the per-worktree git lookups in
# parallel and streaming rows to stdout as they finish (fzf renders them live).
# Output order is non-deterministic — fzf sorts on match anyway. See annotate_one
# for the field layout.
annotate_worktrees() {
  local list jobs
  list="$(list_worktrees)"
  [ -z "$list" ] && return 0

  jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
  export WT_CUR_TOP WT_AGENTS
  WT_CUR_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  WT_AGENTS="$(herdr_agent_statuses)"
  export -f annotate_one agent_label

  # Feed branch and path as separate NUL-delimited tokens (-0 -n2) so values with
  # spaces survive and xargs never reinterprets the tab/field separators.
  printf '%s\n' "$list" | tr '\t\n' '\0\0' \
    | xargs -0 -n2 -P "$jobs" bash -c 'annotate_one "$@"' _
}

pick_worktree() {
  local query="${1:-}"
  local selection

  command -v fzf >/dev/null 2>&1 || die "fzf is required for the interactive picker (https://github.com/junegunn/fzf)"

  # shellcheck disable=SC2016  # $WT_SELF expands in fzf's shell, not here
  selection=$(
    annotate_worktrees |
    fzf_with_preview --delimiter='\t' \
        --height='~50%' --layout=reverse \
        --with-nth=1,2,4,5 \
        --prompt="worktree> " \
        --query="$query" \
        --print-query \
        --header="enter: cd · ctrl-n: new · ctrl-d/del: delete · tab: preview" \
        --expect=ctrl-d,del,ctrl-n \
        --bind='tab:execute-silent("$WT_SELF" _preview-cycle)+refresh-preview'
  ) || true

  # With --print-query and --expect, fzf prints up to three lines: the typed
  # query, the pressed key (empty for plain enter), then the selected row.
  # set -e is suppressed for the group because it precedes a "|| true".
  local query_line key item
  { IFS= read -r query_line; IFS= read -r key; IFS= read -r item; } <<< "$selection" || true

  # ctrl-n: create (or switch to) a worktree named by the typed query.
  if [ "$key" = "ctrl-n" ]; then
    [ -n "$query_line" ] || return 0
    goto_worktree "$query_line"
    return 0
  fi

  # No row selected (empty list or Esc) — nothing to do.
  [ -z "$item" ] && return 0

  local branch wt_path
  branch="$(printf '%s' "$item" | cut -f2)"
  wt_path="$(printf '%s' "$item" | cut -f3)"

  if [ "$key" = "ctrl-d" ] || [ "$key" = "del" ]; then
    remove_worktree "$branch"
    return 0
  fi

  if [ -d "$wt_path" ]; then
    echo "$wt_path"
  else
    die "worktree path not found: $wt_path"
  fi
}

create_worktree() {
  local branch="$1"
  local start_point="${2:-}"
  local base
  base="$(worktree_base)"
  local wt_path
  wt_path="$base/$(safe_dirname "$branch")"

  if [ -d "$wt_path" ]; then
    # The dir already exists. Guard against safe_dirname collisions: "a/b" and
    # "a-b" both flatten to "a-b". If it's a worktree for a *different* branch,
    # refuse rather than silently switching to the wrong tree; otherwise treat
    # the call as idempotent and just hand back the path.
    local occupant
    occupant="$(git -C "$wt_path" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    if [ -n "$occupant" ] && [ "$occupant" != "$branch" ]; then
      die "worktree dir already used by branch '$occupant': $wt_path (rename to avoid the slash/dash collision, or set WT_BASE_DIR)"
    fi
    echo "$wt_path"
    return 0
  fi

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    spin "Creating worktree $branch" git worktree add "$wt_path" "$branch"
  elif [ -n "$start_point" ]; then
    spin "Creating worktree $branch" git worktree add -b "$branch" "$wt_path" "$start_point"
  else
    spin "Creating worktree $branch" git worktree add -b "$branch" "$wt_path"
  fi

  run_hooks "$branch" "$wt_path"
  echo "$wt_path"
}

get_worktree_path() {
  local branch="$1"
  list_worktrees "$branch"
}

# Get or create a worktree for <branch>, print its path
goto_worktree() {
  local branch="$1"
  local start_point="${2:-}"
  local wt_path

  # Check if a worktree for this branch already exists
  wt_path=$(get_worktree_path "$branch")

  if [ -n "$wt_path" ]; then
    echo "$wt_path"
  else
    create_worktree "$branch" "$start_point"
  fi
}

remove_worktree() {
  local branch="$1"
  local wt_path

  wt_path=$(get_worktree_path "$branch")

  if [ -z "$wt_path" ]; then
    die "no worktree found for branch: $branch"
  fi

  remove_worktree_at "$wt_path" "$branch"
}

# Remove the worktree at <path>, checked out on <branch> ("(detached)" if
# none), then delete the branch if it is fully merged. A worktree whose
# directory is already gone is pruned from git's records instead.
remove_worktree_at() {
  local wt_path="$1" branch="$2"

  # Refuse to remove a worktree with uncommitted *tracked* changes. Untracked
  # files are expected (postCreate hooks build node_modules etc.), so we force
  # past those — but never past unsaved edits to tracked files.
  local tracked_dirty
  tracked_dirty="$(git -C "$wt_path" status --porcelain --untracked-files=no 2>/dev/null || true)"
  if [ -n "$tracked_dirty" ]; then
    die "worktree has uncommitted changes: $wt_path (stash/commit them, or run: git worktree remove --force \"$wt_path\")"
  fi

  # Don't pull a checkout out from under a herdr agent that is still busy in it.
  local ws
  ws="$(herdr_workspace_for "$wt_path")"
  if [ -n "$ws" ] && herdr_workspace_busy "$ws"; then
    die "an agent is still working in herdr workspace $ws: $wt_path (let it finish, or close the workspace first)"
  fi

  if [ -d "$wt_path" ]; then
    spin "Removing worktree $branch" git worktree remove --force "$wt_path"
  else
    git worktree prune
  fi
  printf 'Removed worktree: %s (%s)\n' "$branch" "$wt_path" >&2

  # Never delete the default branch, even when it is "merged" into HEAD.
  if [ "$branch" != "(detached)" ] && [ "$branch" != "$(default_branch)" ]; then
    if git branch -d "$branch" >/dev/null 2>&1; then
      printf 'Deleted branch: %s\n' "$branch" >&2
    else
      printf 'Kept branch %s (not fully merged; delete with: git branch -D %s)\n' "$branch" "$branch" >&2
    fi
  fi

  [ -n "$ws" ] && herdr_close_workspace "$ws"
  return 0
}

# --- herdr integration ------------------------------------------------------

# True when running inside a herdr pane with WT_HERDR=workspace. Then switching
# opens the worktree as a herdr workspace instead of cd'ing the current shell.
herdr_enabled() {
  [ "${WT_HERDR:-}" = "workspace" ] && [ "${HERDR_ENV:-}" = "1" ] &&
    command -v herdr >/dev/null 2>&1
}

# Open (or focus, if already open) <path> as a herdr workspace. herdr requires
# the primary checkout as --cwd, and opens its workspace too if needed.
herdr_open() {
  local wt_path="$1" label
  label="$(git -C "$wt_path" symbolic-ref --quiet --short HEAD 2>/dev/null || basename "$wt_path")"
  herdr worktree open --cwd "$(primary_worktree)" --path "$wt_path" \
    --label "$label" --focus >/dev/null
}

# Print the id of the herdr workspace open on <path>, if any. jq is required:
# this lookup guards removal against busy agents, so it must not silently fail.
herdr_workspace_for() {
  local wt_path="$1"
  herdr_enabled || return 0
  command -v jq >/dev/null 2>&1 || die "jq is required for the herdr integration (https://jqlang.org), or unset WT_HERDR"
  herdr worktree list --cwd "$(primary_worktree)" 2>/dev/null |
    jq -r --arg path "$wt_path" \
      'first(.result.worktrees[]? | select(.path == $path) | .open_workspace_id // empty)' \
      2>/dev/null || true
}

# True when an agent in herdr workspace <id> is mid-turn or waiting on input.
herdr_workspace_busy() {
  herdr workspace get "$1" 2>/dev/null |
    jq -e '.result.workspace.agent_status | IN("working", "blocked")' >/dev/null 2>&1
}

# Print "path<TAB>agent_status" for each worktree of this repo that is open as
# a herdr workspace. Display-only, so it quietly prints nothing without jq.
herdr_agent_statuses() {
  herdr_enabled || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local worktrees workspaces
  worktrees="$(herdr worktree list --cwd "$(primary_worktree)" 2>/dev/null)" || return 0
  workspaces="$(herdr workspace list 2>/dev/null)" || return 0
  jq -rn --argjson wt "$worktrees" --argjson ws "$workspaces" '
    ([$ws.result.workspaces[]? | {(.workspace_id): .agent_status}] | add // {}) as $status
    | $wt.result.worktrees[]?
    | select((.open_workspace_id // "") != "")
    | [.path, ($status[.open_workspace_id] // "unknown")]
    | @tsv' 2>/dev/null || true
}

# Close the herdr workspace <id> left behind by a removed worktree — unless it
# is the one this shell runs in, since closing it would kill the caller.
herdr_close_workspace() {
  local ws="$1"
  if [ "$ws" = "${HERDR_WORKSPACE_ID:-}" ]; then
    printf 'Left herdr workspace %s open (it is the current one)\n' "$ws" >&2
    return 0
  fi
  if herdr workspace close "$ws" >/dev/null 2>&1; then
    printf 'Closed herdr workspace: %s\n' "$ws" >&2
  else
    printf '%s: could not close herdr workspace %s\n' "$PROG" "$ws" >&2
  fi
}

# Hand a worktree path to the caller: open it in herdr when enabled, otherwise
# print it for the shell wrapper to cd into. Falls back to printing if herdr fails.
switch_to() {
  local wt_path="$1"
  [ -n "$wt_path" ] || return 0
  if herdr_enabled; then
    herdr_open "$wt_path" && return 0
    printf '%s: herdr could not open %s; switching with cd instead\n' "$PROG" "$wt_path" >&2
  fi
  echo "$wt_path"
}

# --- picker preview ---------------------------------------------------------

# Run fzf with "$@" plus the worktree preview pane, for rows whose third
# tab-separated field is the worktree path. ctrl-/ cycles the preview view.
# The preview runs this script again (wt _preview), so it gets an absolute
# path to it; the view lives in a state file that _preview-cycle rewrites. Both
# travel as env vars so no quoting depends on the user's $SHELL.
fzf_with_preview() {
  local state self rc=0
  state="$(mktemp)"
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  # shellcheck disable=SC2016  # $WT_SELF expands in fzf's shell, not here
  WT_SELF="$self" WT_PREVIEW_STATE="$state" fzf "$@" \
    --preview='"$WT_SELF" _preview {3}' \
    --preview-window=right:60%:wrap \
    --bind='ctrl-/:execute-silent("$WT_SELF" _preview-cycle)+refresh-preview' || rc=$?
  rm -f "$state"
  return $rc
}

# Views the picker's preview pane cycles through with tab, in order.
PREVIEW_MODES=(overview diff)

# The preview mode currently selected, kept in $WT_PREVIEW_STATE by the picker.
preview_mode() {
  local mode=""
  [ -n "${WT_PREVIEW_STATE:-}" ] && mode="$(cat "$WT_PREVIEW_STATE" 2>/dev/null || true)"
  echo "${mode:-${PREVIEW_MODES[0]}}"
}

# Advance $WT_PREVIEW_STATE to the next mode, wrapping around.
preview_cycle() {
  [ -n "${WT_PREVIEW_STATE:-}" ] || return 0
  local cur next="${PREVIEW_MODES[0]}" i
  cur="$(preview_mode)"
  for i in "${!PREVIEW_MODES[@]}"; do
    if [ "${PREVIEW_MODES[i]}" = "$cur" ]; then
      next="${PREVIEW_MODES[(i + 1) % ${#PREVIEW_MODES[@]}]}"
    fi
  done
  printf '%s\n' "$next" > "$WT_PREVIEW_STATE"
}

# Render the preview pane for <path>: a mode bar, then the selected view.
preview_worktree() {
  local wt_path="$1" mode m bar=""
  mode="$(preview_mode)"
  for m in "${PREVIEW_MODES[@]}"; do
    if [ "$m" = "$mode" ]; then bar="$bar"$'\033[7m'" $m "$'\033[0m'" "; else bar="$bar $m  "; fi
  done
  printf '%s\n%s\n\n' "$bar" "$wt_path"

  case "$mode" in
    diff) preview_diff "$wt_path" ;;
    *)    preview_overview "$wt_path" ;;
  esac
}

# Overview: the herdr agent (if any), working-tree status, and recent commits.
preview_overview() {
  local wt_path="$1" status
  status="$(herdr_agent_statuses | P="$wt_path" awk -F'\t' '$1 == ENVIRON["P"] { print $2; exit }')"
  [ -n "$status" ] && printf 'herdr agent: %s\n\n' "$status"
  git -C "$wt_path" -c color.status=always status -sb 2>/dev/null
  echo
  git -C "$wt_path" log --oneline --color=always -10 2>/dev/null || echo 'no commits'
}

# Diff: what this branch adds on top of the default branch — its own commits,
# their combined diffstat, and any uncommitted changes. Compares against the
# remote's copy of the default branch when there is one, since that is what a
# pull request would target.
preview_diff() {
  local wt_path="$1" def base mb count uncommitted
  def="$(default_branch)"
  if [ -z "$def" ]; then
    echo "no default branch to compare against"
    return 0
  fi
  base="$def"
  git -C "$wt_path" rev-parse --verify --quiet "refs/remotes/origin/$def" >/dev/null && base="origin/$def"

  if ! mb="$(git -C "$wt_path" merge-base "$base" HEAD 2>/dev/null)"; then
    echo "no history in common with $base"
    return 0
  fi

  count="$(git -C "$wt_path" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)"
  if [ "$count" = 0 ]; then
    printf 'no commits beyond %s\n' "$base"
  else
    printf '%s commit(s) not on %s:\n' "$count" "$base"
    git -C "$wt_path" log --oneline --color=always "$base..HEAD" 2>/dev/null
    echo
    git -C "$wt_path" diff --stat --color=always "$mb" HEAD 2>/dev/null
  fi

  uncommitted="$(git -C "$wt_path" diff --stat --color=always HEAD 2>/dev/null || true)"
  if [ -n "$uncommitted" ]; then
    printf '\nuncommitted:\n%s\n' "$uncommitted"
  fi
}

# --- pull requests ----------------------------------------------------------

# Pick the remote to fetch PRs from: prefer "origin", else the first remote.
default_remote() {
  if git remote | grep -qx origin; then
    echo origin
  else
    git remote | head -1
  fi
}

# Check out GitHub PR #<n> in a worktree, printing its path.
pr_worktree() {
  local n="$1"
  [ -n "$n" ] || die "usage: $PROG pr <number>"
  case "$n" in ''|*[!0-9]*) die "invalid PR number: $n" ;; esac

  local remote
  remote="$(default_remote)"
  [ -n "$remote" ] || die "no git remote configured"

  # Use gh for a human-friendly branch name when available; otherwise pr-<n>.
  local branch=""
  if command -v gh >/dev/null 2>&1; then
    branch="$(gh pr view "$n" --json headRefName -q .headRefName 2>/dev/null || true)"
  fi
  [ -n "$branch" ] || branch="pr-$n"

  # Already checked out? Just go there.
  local existing
  existing="$(get_worktree_path "$branch")"
  if [ -n "$existing" ]; then
    echo "$existing"
    return 0
  fi

  spin "Fetching PR #$n from $remote" git fetch -q "$remote" "refs/pull/$n/head:$branch" \
    || die "could not fetch PR #$n from $remote"

  local base wt_path
  base="$(worktree_base)"
  wt_path="$base/$(safe_dirname "$branch")"
  spin "Creating worktree $branch" git worktree add "$wt_path" "$branch"
  run_hooks "$branch" "$wt_path"
  echo "$wt_path"
}

# --- clean ------------------------------------------------------------------

# The repo's default branch — used to decide what counts as "merged".
default_branch() {
  local d
  d="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')"
  if [ -n "$d" ]; then echo "$d"; return; fi
  local c
  for c in main master trunk; do
    if git show-ref --verify --quiet "refs/heads/$c"; then echo "$c"; return; fi
  done
  git -C "$(primary_worktree)" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

# Classify one worktree for wt clean and print a raw row of eight tab-separated
# fields: "<rank>\t<kb>\t<verdict>\t<size>\t<age>\t<branch>\t<path>\t<detail>".
# rank orders the verdicts from safest to riskiest; kb is the disk usage used to
# sort within a verdict. Verdicts:
#   safe       merged into the default branch or upstream gone, nothing
#              uncommitted — the worktree and (if merged) its branch go; or
#              its directory is already deleted and only git's record remains
#   idle       not merged, nothing uncommitted — the worktree goes, the branch
#              and its commits stay
#   untracked  untracked files that removal would delete
#   dirty      uncommitted changes to tracked files (refused)
#   orphan     detached HEAD with commits no ref points to (refused)
#   locked     locked with git worktree lock (refused)
#   busy       a herdr agent is working or waiting on input in it (refused)
#   current    the worktree you are in (refused)
# Runs in parallel under xargs, so its context comes from WT_* variables set by
# clean_report.
clean_row() {
  local branch="$1" path="$2"
  local verdict="" detail="" rank kb=0 size="-" age="-" stamp agent tracked untracked

  if [ ! -d "$path" ]; then
    verdict="safe"; detail="directory already deleted"
  else
    kb="$(du -sk "$path" 2>/dev/null | cut -f1)"
    size="$(human_size "${kb:-0}")"
    # Last git activity in this worktree: its HEAD reflog, else the HEAD commit.
    stamp="$(git -C "$path" log -g -1 --format=%ct HEAD 2>/dev/null ||
             git -C "$path" log -1 --format=%ct 2>/dev/null || true)"
    [ -n "$stamp" ] && age="$(human_age $((WT_NOW - stamp)))"

    agent="$(printf '%s\n' "${WT_AGENTS:-}" |
      P="$path" awk -F'\t' '$1 == ENVIRON["P"] { print $2; exit }')"
    tracked="$(git --no-optional-locks -C "$path" status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')"
    untracked="$(git -C "$path" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')"

    if [ "$path" = "${WT_CUR_TOP:-}" ]; then
      verdict="current"; detail="you are here"
    elif [ "$agent" = working ] || [ "$agent" = blocked ]; then
      verdict="busy"; detail="herdr agent $agent"
    elif printf '%s\n' "${WT_LOCKED:-}" | grep -qxF -- "$path"; then
      verdict="locked"; detail="unlock with: git worktree unlock"
    elif [ "${tracked:-0}" != 0 ]; then
      verdict="dirty"; detail="$tracked uncommitted change(s)"
    elif [ "$branch" = "(detached)" ] &&
         [ -z "$(git -C "$path" for-each-ref --contains HEAD --count=1 --format=x 2>/dev/null)" ]; then
      verdict="orphan"; detail="detached HEAD has commits on no branch"
    elif [ "${untracked:-0}" != 0 ]; then
      verdict="untracked"; detail="$untracked untracked file(s) would be deleted"
    fi
  fi

  if [ -z "$verdict" ]; then
    local merged="" gone=""
    printf '%s\n' "${WT_MERGED:-}" | grep -qxF -- "$branch" && merged=1
    printf '%s\n' "${WT_GONE:-}" | grep -qxF -- "$branch" && gone=1
    if [ "$branch" = "${WT_DEF:-}" ]; then
      verdict="idle"; detail="default branch (kept)"
    elif [ -n "$merged" ] && [ -n "$gone" ]; then
      verdict="safe"; detail="merged into $WT_DEF, upstream gone"
    elif [ -n "$merged" ]; then
      verdict="safe"; detail="merged into $WT_DEF"
    elif [ -n "$gone" ]; then
      verdict="safe"; detail="upstream gone (branch kept unless merged)"
    elif [ "$branch" = "(detached)" ]; then
      verdict="idle"; detail="detached HEAD"
    else
      verdict="idle"; detail="not merged (branch kept)"
    fi
  fi

  case "$verdict" in
    safe)      rank=0 ;;
    idle)      rank=1 ;;
    untracked) rank=2 ;;
    *)         rank=3 ;;
  esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$rank" "${kb:-0}" "$verdict" "$size" "$age" "$branch" "$path" "$detail"
}

# Format a size in kilobytes for display: 812K, 34M, 1.2G.
human_size() {
  awk -v kb="$1" 'BEGIN {
    if (kb >= 1048576) printf "%.1fG\n", kb / 1048576
    else if (kb >= 1024) printf "%dM\n", kb / 1024
    else printf "%dK\n", kb
  }'
}

# Format an age in seconds for display: 12m, 5h, 3d.
human_age() {
  local s="$1"
  if [ "$s" -lt 3600 ]; then echo "$((s / 60))m"
  elif [ "$s" -lt 86400 ]; then echo "$((s / 3600))h"
  else echo "$((s / 86400))d"
  fi
}

# Classify every worktree except the primary one (see clean_row), measuring
# them in parallel, and print the raw rows sorted safest-first, then by size.
clean_report() {
  local list primary jobs
  primary="$(primary_worktree)"
  list="$(list_worktrees | P="$primary" awk -F'\t' '$2 != ENVIRON["P"]')"
  # GNU xargs runs its command once even on empty input, so stop here.
  [ -z "$list" ] && return 0

  export WT_CUR_TOP WT_AGENTS WT_DEF WT_MERGED WT_GONE WT_LOCKED WT_NOW
  WT_CUR_TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  WT_AGENTS="$(herdr_agent_statuses)"
  WT_DEF="$(default_branch)"
  WT_MERGED="$(git branch --merged "$WT_DEF" --format='%(refname:short)' 2>/dev/null || true)"
  WT_GONE="$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |
               awk '$2 == "[gone]" { print $1 }')"
  WT_LOCKED="$(git worktree list --porcelain |
                 awk '/^worktree / { path = substr($0, 10) } /^locked/ { print path }')"
  WT_NOW="$(date +%s)"
  export -f clean_row human_size human_age

  jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
  printf '%s\n' "$list" |
    tr '\t\n' '\0\0' |
    xargs -0 -n2 -P "$jobs" bash -c 'clean_row "$@"' _ |
    sort -t$'\t' -k1,1n -k2,2nr
}

# clean_report into <file>, so spin can run it while stdout stays free.
clean_report_to() {
  clean_report > "$1"
}

# Print a one-line summary of raw clean_report rows: how many worktrees, their
# total size, and how much the safe ones would free.
clean_summary() {
  awk -F'\t' '
    function h(kb) {
      if (kb >= 1048576) return sprintf("%.1fG", kb / 1048576)
      if (kb >= 1024) return sprintf("%dM", kb / 1024)
      return sprintf("%dK", kb)
    }
    { n++; total += $2 }
    $3 == "safe" { s++; safe += $2 }
    END { printf "%d worktree(s) · %s on disk · %d safe to remove (%s)\n", n, h(total), s, h(safe) }'
}

# Turn raw clean_report rows into aligned display rows for fzf, keeping the
# branch, path, and verdict in their own fields after the display text.
clean_display() {
  while IFS=$'\t' read -r _ _ verdict size age branch path detail; do
    printf '%-9s %6s %4s  %-32s %s\t%s\t%s\t%s\n' \
      "$verdict" "$size" "$age" "$branch" "$detail" "$branch" "$path" "$verdict"
  done
}

# Remove the worktrees in raw rows on stdin, skipping verdicts that must not be
# removed. Each removal runs in a subshell so one failure (die) doesn't stop
# the rest.
clean_remove() {
  while IFS=$'\t' read -r branch path verdict; do
    [ -z "$path" ] && continue
    case "$verdict" in
      safe|idle|untracked)
        ( remove_worktree_at "$path" "$branch" ) || true ;;
      *)
        printf '%s: skipped %s (%s)\n' "$PROG" "$branch" "$verdict" >&2 ;;
    esac
  done
}

clean_worktrees() {
  local do_prune="" assume_yes="" list_only=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --prune)            do_prune=1 ;;
      -y|--yes|--all)     assume_yes=1 ;;
      -l|--list)          list_only=1 ;;
      *)                  die "unknown clean option: $1 (use --list, --prune, --yes)" ;;
    esac
    shift
  done

  # --prune refreshes remote-tracking refs first so "upstream gone" is accurate.
  if [ -n "$do_prune" ]; then
    printf '%s: fetching and pruning remotes...\n' "$PROG" >&2
    git fetch --all --prune -q >&2 || printf '%s: prune fetch failed (continuing)\n' "$PROG" >&2
  fi

  local rows
  rows="$(mktemp)"
  spin "Measuring worktrees" clean_report_to "$rows"
  if [ ! -s "$rows" ]; then
    rm -f "$rows"
    printf '%s: nothing to clean — no worktrees besides the primary one\n' "$PROG" >&2
    return 0
  fi

  local summary
  summary="$(clean_summary < "$rows")"

  # --yes removes every safe worktree without prompting (handy for scripts).
  if [ -n "$assume_yes" ]; then
    awk -F'\t' '$3 == "safe" { print $6 "\t" $7 "\t" $3 }' "$rows" | clean_remove
    rm -f "$rows"
    return 0
  fi

  if [ -n "$list_only" ] || ! command -v fzf >/dev/null 2>&1; then
    printf '%s\n' "$summary"
    clean_display < "$rows" | cut -f1
    [ -z "$list_only" ] && printf '%s: install fzf to pick interactively, or use --yes / -d\n' "$PROG" >&2
    rm -f "$rows"
    return 0
  fi

  local selection
  selection=$(
    clean_display < "$rows" |
    fzf_with_preview --multi --delimiter='\t' --with-nth=1 \
        --height='~80%' --layout=reverse \
        --prompt="clean> " \
        --header="$summary
tab: mark · ctrl-a: mark all shown (type 'safe' to filter) · enter: remove · ctrl-/: preview" \
        --bind='ctrl-a:select-all'
  ) || true
  rm -f "$rows"

  [ -z "$selection" ] && return 0
  printf '%s\n' "$selection" | cut -f2- | clean_remove
}

# --- shell integration ------------------------------------------------------

print_sh_wrapper() {
  cat <<'SHELL'
wt() {
  if [ "$1" = "init" ] || [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ "$1" = "-v" ] || [ "$1" = "--version" ]; then
    command wt "$@"
    return
  fi
  local result
  result="$(command wt "$@")" || return $?
  if [ -d "$result" ]; then
    cd "$result" || return
  elif [ -n "$result" ]; then
    printf '%s\n' "$result"
  fi
}
SHELL
}

shell_init() {
  local shell="${1:-}"
  case "$shell" in
    bash)
      print_sh_wrapper
      cat <<'SHELL'
_wt() {
  local cur prev
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  case "$prev" in
    -d)
      local worktrees
      worktrees="$(git worktree list --porcelain 2>/dev/null | awk '/^branch / { b = substr($0, 8); sub("refs/heads/", "", b); print b }')"
      COMPREPLY=($(compgen -W "$worktrees" -- "$cur"))
      return
      ;;
    init)
      COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur"))
      return
      ;;
  esac

  if [[ "${COMP_WORDS[1]}" == clean ]]; then
    COMPREPLY=($(compgen -W "--list --prune --yes" -- "$cur"))
  elif [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "-d -l -h -v" -- "$cur"))
  else
    local branches
    branches="$(git branch --format='%(refname:short)' 2>/dev/null)"
    COMPREPLY=($(compgen -W "$branches pr clean" -- "$cur"))
  fi
}
complete -F _wt wt
SHELL
      ;;
    zsh)
      print_sh_wrapper
      cat <<'SHELL'
_wt() {
  local -a branches worktrees shells opts
  shells=(bash zsh fish)
  opts=(-d -l -h -v)

  _arguments -s \
    '(-d -l -h -v)1:command:(init pr clean)' \
    '-d[Remove worktree]:branch:->worktrees' \
    '-l[List worktrees]' \
    '-h[Show help]' \
    '-v[Show version]' \
    '*:branch:->branches' \
    && return

  case "$state" in
    worktrees)
      worktrees=(${(f)"$(git worktree list --porcelain 2>/dev/null | awk '/^branch / { b = substr($0, 8); sub("refs/heads/", "", b); print b }')"})
      _describe 'worktree branch' worktrees
      ;;
    branches)
      if [[ "${words[2]}" == "init" ]]; then
        _describe 'shell' shells
      elif [[ "${words[2]}" == "clean" ]]; then
        _values 'clean option' '--list[print the report only]' \
          '--prune[fetch and prune remotes first]' '--yes[remove every safe worktree]'
      else
        branches=(${(f)"$(git branch --format='%(refname:short)' 2>/dev/null)"})
        _describe 'branch' branches
      fi
      ;;
  esac
}
compdef _wt wt
SHELL
      ;;
    fish)
      cat <<'SHELL'
function wt
  if test (count $argv) -gt 0
    switch $argv[1]
      case init -h --help -v --version
        command wt $argv
        return
    end
  end
  set -l result (command wt $argv)
  or return $status
  if test -d "$result"
    cd "$result"
  else if test -n "$result"
    echo "$result"
  end
end

# Clear any existing completions for wt
complete -e -c wt

# Flags
complete -c wt -s d -x -d 'Remove worktree' -a '(git worktree list --porcelain 2>/dev/null | string match -r "^branch refs/heads/(.*)" | string replace -r "^branch refs/heads/" "")'
complete -c wt -s l -d 'List worktrees'
complete -c wt -s h -d 'Show help'
complete -c wt -s v -d 'Show version'

# Subcommands
complete -c wt -n "__fish_use_subcommand" -a "pr" -d 'Check out a GitHub PR'
complete -c wt -n "__fish_use_subcommand" -a "clean" -d 'Review and remove worktrees'
complete -c wt -n "__fish_seen_subcommand_from init" -x -a "bash zsh fish"
complete -c wt -n "__fish_seen_subcommand_from clean" -l list -d 'Print the report only'
complete -c wt -n "__fish_seen_subcommand_from clean" -l prune -d 'Fetch and prune remotes first'
complete -c wt -n "__fish_seen_subcommand_from clean" -l yes -d 'Remove every safe worktree'

# Default: branch names
complete -c wt -n "not __fish_seen_subcommand_from init pr clean; and not __fish_is_switch" -x -a '(git branch --format="%(refname:short)" 2>/dev/null)'
SHELL
      ;;
    *)
      die "unsupported shell: ${shell:-<none>} (use bash, zsh, or fish)"
      ;;
  esac
}

# --- main -------------------------------------------------------------------

main() {
  local mode=""
  local branch=""
  local start_point=""
  local OPTIND

  # Handle subcommands before getopts
  case "${1:-}" in
    init)
      shift
      shell_init "${1:-}"
      return 0
      ;;
    pr)
      shift
      ensure_git
      local pr_path
      pr_path="$(pr_worktree "${1:-}")" || return $?
      switch_to "$pr_path"
      return 0
      ;;
    clean)
      shift
      ensure_git
      clean_worktrees "$@"
      return 0
      ;;
    # Internal: called by the picker's fzf preview and its tab binding.
    _preview)
      preview_worktree "${2:-}"
      return 0
      ;;
    _preview-cycle)
      preview_cycle
      return 0
      ;;
  esac

  while getopts ":d:lhv" opt; do
    case "$opt" in
      d) mode="delete"; branch="$OPTARG" ;;
      l) mode="list" ;;
      h) usage ;;
      v) echo "$PROG $VERSION"; exit 0 ;;
      :) die "option -$OPTARG requires an argument" ;;
      *) die "unknown option: -$OPTARG" ;;
    esac
  done
  shift $((OPTIND - 1))

  ensure_git

  # Default mode: if a positional arg is given, go to that branch; otherwise fzf
  if [ -z "$mode" ]; then
    if [ $# -gt 0 ]; then
      mode="goto"
      branch="$1"
      start_point="${2:-}"
    else
      mode="pick"
    fi
  fi

  case "$mode" in
    pick)
      local picked
      picked="$(pick_worktree "")" || return $?
      switch_to "$picked"
      ;;
    goto)
      local target
      target="$(goto_worktree "$branch" "$start_point")" || return $?
      switch_to "$target"
      ;;
    delete)
      remove_worktree "$branch"
      ;;
    list)
      annotate_worktrees | while IFS=$'\t' read -r flags branch path ab agent; do
        printf '%s %-30s %s%s\n' "$flags" "$branch$ab" "$path" "${agent:+  $agent}"
      done
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
